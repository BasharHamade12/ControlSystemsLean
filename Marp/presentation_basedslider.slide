    text "e309" {
        x: 1258;
        y: 562;
        width: 540;
        height: 90;
        content: "$s \\in R(\\Omega)$ gives $\\delta \\in \\Omega$\nwith $\\tilde{P}_\\delta(s) = 0$";
        fontSize: 20;
        lineHeight: 1.45;
        color: "#24313f";
