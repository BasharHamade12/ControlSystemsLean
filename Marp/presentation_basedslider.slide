    }

    rect "e65" {
        x: 120;
        y: 196;
        width: 1680;
        height: 196;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a54";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e66" {
        x: 120;
        y: 196;
        width: 8;
        height: 196;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a55";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e67" {
        x: 160;
        y: 216;
        width: 1600;
        height: 34;
        content: "Continuous-time stability criterion";
        fontSize: 24;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a56";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e68" {
        x: 160;
        y: 250;
        width: 1600;
        height: 46;
        content: "A system is stable iff all poles of $G(s)$ have strictly negative real parts, and unstable if any pole has a positive real part.";
        fontSize: 24;
        color: "#24313f";
        math: true;
        animate {
            id: "a57";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e69" {
        x: 160;
        y: 306;
        width: 1600;
        height: 34;
        content: "Discrete-time stability criterion";
        fontSize: 24;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a58";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e70" {
        x: 160;
        y: 340;
        width: 1600;
        height: 46;
        content: "A system is stable iff all poles of $G(z)$ lie strictly inside the unit circle, $|z| < 1$.";
        fontSize: 24;
        color: "#24313f";
        math: true;
        animate {
            id: "a59";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e71" {
        x: 120;
        y: 420;
        width: 1680;
        height: 90;
        content: "Example. $G(s) = \\dfrac{1}{s^2+2s+3}$: the poles solve $s^2 + 2s + 3 = 0$, so";
        fontSize: 26;
        color: "#24313f";
        math: true;
        animate {
            id: "a60";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e72" {
        x: 120;
        y: 520;
        width: 1680;
        height: 96;
        content: "s = \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a} = \\frac{-2 \\pm \\sqrt{-8}}{2} = -1 \\pm j\\sqrt{2}";
        animate {
            id: "a61";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e73" {
        x: 120;
        y: 632;
        width: 1680;
        height: 80;
        content: "so with $p_1 = -1 + j\\sqrt{2}$ and $p_2 = -1 - j\\sqrt{2}$, $\\mathrm{Re}(p_1) = \\mathrm{Re}(p_2) = -1 < 0$, hence the system is stable.";
        fontSize: 26;
        color: "#24313f";
        math: true;
        animate {
            id: "a62";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    image "e74" {
        x: 767;
        y: 730;
        width: 190;
        height: 151;
        src: "data:image/png;base64,";
        animate {
