slide "Step 2 — Dimension count: the picture" {
    id: "s33";
    background: "#ffffff";

    text "e337" {
        x: 120;
        y: 40;
        width: 1300;
        height: 60;
        content: "Step 2 — Dimension count: the picture";
        fontSize: 36;
        fontWeight: 700;
        color: "#12233a";
    }

    text "e338" {
        x: 1380;
        y: 52;
        width: 420;
        height: 40;
        content: "drag to rotate · scroll to zoom";
        fontSize: 17;
        align: "right";
        color: "#5c6878";
    }

    rect "e339" {
        x: 120;
        y: 110;
        width: 120;
        height: 5;
        fill: "#1f4e79";
        radius: 3;
    }

    html "e340" {
        x: 72;
        y: 140;
        width: 1776;
        height: 900;
        content: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>Step 2 — Count: dim(U ∩ dir) ≥ 1</title>\n<style>\n  :root{\n    --u:#3E7BE0;\n    --d:#DD8A24;\n    --a:#3FA46A;\n    --o:#2F7D50;\n    --meet:#1B4F9C;\n    --esc:#D2412F;\n    --ink:#1D2430;\n    --muted:#616B7A;\n    --bg:#FFFFFF;\n    --rule:rgba(120,132,150,.28);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;background:var(--bg);color:var(--ink);\n    font:14px/1.5 ui-sans-serif,-apple-system,\"Segoe UI\",Roboto,sans-serif}\n  .wrap{max-width:980px;margin:0 auto;padding:16px 18px 28px}\n  h1{font-size:16px;margin:0 0 3px;font-weight:650}\n  .sub{color:var(--muted);font-size:13px;margin:0 0 12px}\n  canvas{width:100%;height:540px;display:block;border-radius:12px;\n    border:1px solid var(--rule);background:#fff;touch-action:none;cursor:grab}\n  canvas.drag{cursor:grabbing}\n  .legend{display:flex;flex-wrap:wrap;gap:9px 20px;margin:13px 0 0;padding:0;list-style:none;font-size:13px}\n  .legend li{display:flex;align-items:center;gap:7px;color:var(--ink)}\n  .sw{width:14px;height:14px;border-radius:3px;flex:0 0 auto;border:1px solid rgba(0,0,0,.16)}\n  .sw.line{height:4px;border-radius:2px;width:20px;border:0}\n  .note{color:var(--muted);font-size:12.5px;margin:11px 0 0;max-width:78ch}\n  .num{font-variant-numeric:tabular-nums}\n  .bar{display:flex;align-items:center;gap:14px;margin:12px 0 0;flex-wrap:wrap}\n  button{font:inherit;font-size:13px;padding:6px 13px;border-radius:8px;cursor:pointer;\n    border:1px solid var(--rule);background:#fff;color:var(--ink)}\n  button:hover{background:#F5F7FA}\n  button.primary{border-color:#B9CBE6;background:#EEF4FD}\n  .status{color:var(--muted);font-size:12.5px;font-variant-numeric:tabular-nums}\n</style>\n<style>\n/* slide-embed overrides: fill the iframe, drop the page chrome the slide already has */\nhtml,body{height:100%;overflow:hidden;font-size:15px}\nmain,.wrap{max-width:1280px!important;width:100%!important;height:100%;margin:0 auto!important;\n  padding:12px 16px 10px!important;display:flex;flex-direction:column;gap:9px}\nheader{max-width:none!important}\nh1,.sub{display:none!important}\n.claim{margin:0!important;font-size:15px!important;line-height:1.45!important;max-width:none!important;padding:6px 11px!important}\n.layout{flex:1 1 auto;min-height:0;align-items:stretch!important;gap:16px!important}\n.fig{display:flex;flex-direction:column;flex:1 1 auto;min-height:0}\n/* height:0 + flex-grow makes the canvas take exactly the leftover box, so the\n   viewer's own resize() measures the same size it ends up painting into. */\ncanvas{flex:1 1 0!important;height:0!important;min-height:0!important;width:100%!important;\n  border-radius:10px!important}\n.bar{margin:0!important;flex:0 0 auto}\n.legend{margin:0!important;font-size:13.5px!important;max-width:none!important;flex:0 0 auto;gap:7px 18px!important}\n.note{margin:0!important;font-size:12.5px!important;line-height:1.4!important;max-width:none!important;flex:0 0 auto}\n.caption{margin:4px 0 0!important;min-height:0!important}\n#cap{font-size:13.5px!important;max-width:none!important}\n#lean{font-size:12px!important;max-width:none!important;margin:4px 0 0!important}\naside{flex:0 0 360px!important;position:static!important;min-height:0;display:flex;flex-direction:column}\n#steps{gap:5px!important;overflow:hidden}\nbutton.step{padding:5px 9px!important}\n.hint{margin:6px 0 0!important;font-size:11px!important}\nbutton{font-size:13.5px!important}\n#save{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <canvas id=\"c\" aria-label=\"Interactive 3D figure: Ω inside aff Ω, cut by the linear space U\"></canvas>\n\n  <div class=\"bar\">\n    <button class=\"primary\" id=\"reset\">Reset view</button>\n    <button id=\"save\">Save PNG</button>\n    <span class=\"status\" id=\"status\">drag to rotate · scroll to zoom</span>\n  </div>\n\n  <ul class=\"legend\">\n    <li><span class=\"sw\" style=\"background:var(--o)\"></span> Ω — the polytope (dim 2)</li>\n    <li><span class=\"sw\" style=\"background:var(--a);opacity:.35\"></span> aff Ω — its affine hull</li>\n    <li><span class=\"sw\" style=\"background:var(--u);opacity:.5\"></span> U — linear space through 0</li>\n    <li><span class=\"sw\" style=\"background:var(--d);opacity:.45\"></span> dir(aff Ω) — direction space</li>\n    <li><span class=\"sw line\" style=\"background:var(--meet)\"></span> U ∩ dir(aff Ω) — the meet</li>\n    <li><span class=\"sw line\" style=\"background:var(--esc)\"></span> δ + (U ∩ dir) — the escape line</li>\n  </ul>\n\n  <p class=\"note\">Worked in ℝ³: <span class=\"num\">U = {δ₂ = 0}</span>,\n     <span class=\"num\">dir(aff Ω) = span{(1,0,1),(0,1,1)} = {δ₂ = δ₀+δ₁}</span>,\n     <span class=\"num\">δ = (−1.2, −1.2, 0)</span>, and Ω the parallelogram\n     <span class=\"num\">δ + [−0.85, 0.85]²</span> in aff Ω. Since\n     <span class=\"num\">2 + 2 − 3 = 1</span>, the meet is a line — so from δ you can move\n     a whole line's worth inside U ∩ aff Ω, until you hit ∂Ω (the orange points).\n     Drag to rotate · scroll to zoom.</p>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var cv  = document.getElementById(\"c\");\n  var ctx = cv.getContext(\"2d\");\n  var W = 0, H = 0, DPR = 1;\n\n  // ---- camera ------------------------------------------------------------\n  var az = -2.36, el = 0.62, zoom = 1.0;\n  var dragging = false, lastX = 0, lastY = 0;\n\n  // ---- geometry ----------------------------------------------------------\n  var A = [1, 0, 1];          //  direction basis of dir(aff Ω)\n  var B = [0, 1, 1];\n  var DELTA = [-1.2, -1.2, 0];  // δ ∈ U ∩ aff Ω,  U = {z = 0}\n  var MEET_DIR = [1, -1, 0];    // U ∩ dir(aff Ω)\n  var RADIUS = 0.85;            // Ω = δ + [-R,R]^2 in aff Ω\n\n  function patch(a, b, origin, s) {\n    return [[s, s], [s, -s], [-s, -s], [-s, s]].map(function (q) {\n      return [\n        origin[0] + q[0] * a[0] + q[1] * b[0],\n        origin[1] + q[0] * a[1] + q[1] * b[1],\n        origin[2] + q[0] * a[2] + q[1] * b[2]\n      ];\n    });\n  }\n\n  var U_PATCH   = patch([1, 0, 0], [0, 1, 0], [0, 0, 0], 2.55);  // z = 0\n  var DIR_PATCH = patch(A, B, [0, 0, 0], 1.45);                  // z = x + y\n  var AFF_PATCH = patch(A, B, DELTA, 1.45);                      // z = x + y + 2.4\n  var OMEGA     = patch(A, B, DELTA, RADIUS);                    // Ω itself\n\n  var U_LINE   = [[-2.4, 2.4, 0], [2.4, -2.4, 0]];               // through 0\n  var ESC_IN   = [\n    [DELTA[0] - RADIUS, DELTA[1] + RADIUS, 0],\n    [DELTA[0] + RADIUS, DELTA[1] - RADIUS, 0]\n  ];\n  var ESC_OUT = [\n    [DELTA[0] - 2.1, DELTA[1] + 2.1, 0],\n    [DELTA[0] + 2.1, DELTA[1] - 2.1, 0]\n  ];\n  var D_BOUND = ESC_IN;\n  var ORIGIN = [0, 0, 0];\n\n  // ---- projection --------------------------------------------------------\n  var cam = { f: [0, 0, 1], r: [1, 0, 0], u: [0, 1, 0] };\n\n  // orthographic camera: exact angles, no perspective distortion\n  function updateCamera() {\n    var fx = Math.cos(el) * Math.cos(az), fy = Math.cos(el) * Math.sin(az), fz = Math.sin(el);\n    cam.f = [fx, fy, fz];\n\n    var rx = -fy, ry = fx, rz = 0;\n    var rn = Math.hypot(rx, ry) || 1;\n    cam.r = [rx / rn, ry / rn, 0];\n\n    cam.u = [\n      fy * 0 - fz * cam.r[1],\n      fz * cam.r[0] - fx * 0,\n      fx * cam.r[1] - fy * cam.r[0]\n    ];\n  }\n\n  function project(p) {\n    var xc = p[0] * cam.r[0] + p[1] * cam.r[1] + p[2] * cam.r[2];\n    var yc = p[0] * cam.u[0] + p[1] * cam.u[1] + p[2] * cam.u[2];\n    var depth = -(p[0] * cam.f[0] + p[1] * cam.f[1] + p[2] * cam.f[2]);\n    var s = Math.min(W, H) * 0.135 * zoom;\n    return { x: W / 2 + xc * s, y: H / 2 - yc * s, z: depth };\n  }\n\n  // ---- primitives --------------------------------------------------------\n  function poly(points, fill, stroke, lw, shift) {\n    var pr = points.map(project);\n    var d = pr.reduce(function (t, p) { return t + p.z; }, 0) / pr.length;\n    return { depth: d + (shift || 0), draw: function () {\n      ctx.beginPath();\n      pr.forEach(function (p, i) { i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); });\n      ctx.closePath();\n      if (fill) { ctx.fillStyle = fill; ctx.fill(); }\n      if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = lw || 1; ctx.stroke(); }\n    }};\n  }\n\n  function line(pts, color, width, dash, shift) {\n    var pr = pts.map(project);\n    var d = pr.reduce(function (t, p) { return t + p.z; }, 0) / pr.length;\n    return { depth: d + (shift || 0), draw: function () {\n      ctx.save();\n      ctx.beginPath();\n      pr.forEach(function (p, i) { i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); });\n      ctx.setLineDash(dash || []);\n      ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = \"round\";\n      ctx.stroke();\n      ctx.restore();\n    }};\n  }\n\n  function dot(p, color, r) {\n    var q = project(p);\n    return { depth: q.z - 1, draw: function () {\n      ctx.beginPath(); ctx.arc(q.x, q.y, r, 0, Math.PI * 2);\n      ctx.fillStyle = color; ctx.fill();\n      ctx.lineWidth = 1.5; ctx.strokeStyle = \"#fff\"; ctx.stroke();\n    }};\n  }\n\n  function label(p, text, color, dx, dy) {\n    var q = project(p);\n    return { depth: q.z - 500, draw: function () {\n      ctx.font = \"600 12.5px ui-sans-serif,-apple-system,Segoe UI,Roboto,sans-serif\";\n      var w = ctx.measureText(text).width;\n      var x = q.x + (dx || 10), y = q.y + (dy || -10);\n      ctx.fillStyle = \"rgba(255,255,255,.86)\";\n      ctx.fillRect(x - 3, y - 12, w + 6, 16);\n      ctx.fillStyle = color;\n      ctx.fillText(text, x, y);\n    }};\n  }\n\n  // ---- render ------------------------------------------------------------\n  function render() {\n    updateCamera();\n    ctx.clearRect(0, 0, W, H);\n\n    var items = [\n      // reference axes\n      line([[-2.5, 0, 0], [2.5, 0, 0]], \"rgba(120,132,150,.35)\", 1),\n      line([[0, -2.5, 0], [0, 2.5, 0]], \"rgba(120,132,150,.35)\", 1),\n      line([[0, 0, -2.2], [0, 0, 2.2]], \"rgba(120,132,150,.35)\", 1),\n\n      // the spaces\n      poly(U_PATCH,   \"rgba(62,123,224,.13)\",  \"rgba(62,123,224,.5)\",  1.1, 0),\n      poly(DIR_PATCH, \"rgba(221,138,36,.12)\",  \"rgba(221,138,36,.55)\", 1.1, 0),\n      poly(AFF_PATCH, \"rgba(63,164,106,.10)\",  \"rgba(63,164,106,.45)\", 1.2, -0.02),\n\n      // the polytope Omega, sitting inside aff Omega\n      poly(OMEGA, \"rgba(63,164,106,.42)\", \"#2F7D50\", 2.4, 0.05),\n\n      // the meet and the escape line\n      line(U_LINE,  \"#1B4F9C\", 3.2, [], -0.15),\n      line(ESC_OUT, \"#D2412F\", 2.2, [6, 5], -0.1),\n      line(ESC_IN,  \"#D2412F\", 3.4, [], 0.1),\n\n      // points\n      dot(ORIGIN, \"#77808D\", 4),\n      dot(DELTA,  \"#D2412F\", 6.5),\n      dot(D_BOUND[0], \"#DD8A24\", 5),\n      dot(D_BOUND[1], \"#DD8A24\", 5),\n\n      // labels\n      label([-2.5, 2.5, 0], \"U\", \"#2F63BE\", -8, -10),\n      label([1.05, 0.45, 1.5], \"dir(aff Ω)\", \"#B4701D\", 8, -8),\n      label([0.25, -1.15, 1.45], \"aff Ω\", \"#2F7D50\", 6, 14),\n      label([-0.7, -0.9, 0.8], \"Ω\", \"#1F5C3A\", 10, 4),\n      label(DELTA, \"δ\", \"#D2412F\", -20, 4),\n      label(D_BOUND[0], \"∂Ω\", \"#B4701D\", -34, 4),\n      label([2.05, -2.05, 0], \"U ∩ dir\", \"#1B4F9C\", 8, -6)\n    ];\n\n    items.sort(function (a, b) { return b.depth - a.depth; });\n    items.forEach(function (it) { it.draw(); });\n  }\n\n  // ---- sizing / input ----------------------------------------------------\n  function resize() {\n    DPR = Math.min(window.devicePixelRatio || 1, 2);\n    var r = cv.getBoundingClientRect();\n    W = Math.max(320, Math.round(r.width));\n    H = Math.max(280, Math.round(r.height));\n    cv.width  = Math.round(W * DPR);\n    cv.height = Math.round(H * DPR);\n    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);\n    render();\n  }\n\n  cv.addEventListener(\"pointerdown\", function (e) {\n    dragging = true; lastX = e.clientX; lastY = e.clientY;\n    cv.classList.add(\"drag\"); cv.setPointerCapture(e.pointerId);\n  });\n  cv.addEventListener(\"pointermove\", function (e) {\n    if (!dragging) return;\n    az -= (e.clientX - lastX) * 0.008;\n    el += (e.clientY - lastY) * 0.006;\n    el = Math.max(-1.32, Math.min(1.32, el));\n    lastX = e.clientX; lastY = e.clientY;\n    render();\n  });\n  function endDrag(e) {\n    dragging = false; cv.classList.remove(\"drag\");\n    if (e && e.pointerId !== undefined && cv.hasPointerCapture(e.pointerId)) {\n      cv.releasePointerCapture(e.pointerId);\n    }\n  }\n  cv.addEventListener(\"pointerup\", endDrag);\n  cv.addEventListener(\"pointercancel\", endDrag);\n  cv.addEventListener(\"wheel\", function (e) {\n    e.preventDefault();\n    zoom = Math.max(0.45, Math.min(3.5, zoom * Math.exp(-e.deltaY * 0.0012)));\n    render();\n  }, { passive: false });\n\n  window.addEventListener(\"resize\", resize);\n  resize();\n\n  // ---- toolbar -----------------------------------------------------------\n  var AZ0 = -2.36, EL0 = 0.62, ZOOM0 = 1.0;\n\n  document.getElementById(\"reset\").addEventListener(\"click\", function () {\n    az = AZ0; el = EL0; zoom = ZOOM0;\n    render();\n  });\n\n  document.getElementById(\"save\").addEventListener(\"click\", savePNG);\n\n  function savePNG() {\n    var out = document.createElement(\"canvas\");\n    out.width = cv.width; out.height = cv.height;\n    var octx = out.getContext(\"2d\");\n    octx.fillStyle = \"#fff\";\n    octx.fillRect(0, 0, out.width, out.height);\n    octx.drawImage(cv, 0, 0);\n    var a = document.createElement(\"a\");\n    a.download = \"step2_count.png\";\n    a.href = out.toDataURL(\"image/png\");\n    a.click();\n  }\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"s\" || e.key === \"S\") savePNG();\n    if (e.key === \"r\" || e.key === \"R\") {\n      az = AZ0; el = EL0; zoom = ZOOM0; render();\n    }\n  });\n})();\n</script>\n<script>\n(function(){\n  var c=document.getElementById('c'); if(!c) return;\n  function fix(){ try { window.dispatchEvent(new Event('resize')); } catch(e){} }\n  if (window.ResizeObserver) { new ResizeObserver(fix).observe(c); }\n  window.addEventListener('load', fix);\n  setTimeout(fix, 60); setTimeout(fix, 300); setTimeout(fix, 900);\n  // Optional nudge: one wheel notch so the drawing uses more of the box.\n  var zoomIn = 0.88;\n  if (Math.abs(zoomIn - 1) > 0.01) {\n    setTimeout(function(){\n      c.dispatchEvent(new WheelEvent('wheel', {\n        deltaY: -Math.log(zoomIn) / 0.0012, bubbles: true, cancelable: true\n      }));\n    }, 1000);\n  }\n})();\n</script>\n</body>\n</html>\n";
        radius: 10;
    }
}

slide "Step 3: Escape — Lean + map" {
    id: "s34";
    background: "#ffffff";

    text "e341" {
        x: 120;
        y: 56;
        width: 1700;
        height: 76;
        content: "Step 3: Escape — Lean + map";
        fontSize: 42;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e342" {
        x: 120;
        y: 148;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e343" {
        x: 120;
        y: 176;
        width: 1680;
        height: 130;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a258";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e344" {
        x: 120;
        y: 176;
        width: 8;
