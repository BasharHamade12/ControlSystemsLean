    text "e186" {
        x: 152;
        y: 254;
        width: 940;
        height: 70;
        content: "For $\\delta = (\\delta_0,\\dots,\\delta_n) \\in \\mathbb{R}^{n+1}$ we write $\\operatorname{polyOfVec}(\\delta)(s) = \\delta_0 + \\delta_1 s + \\cdots + \\delta_n s^n$.";
        fontSize: 22;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a144";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

