    code "e667" {
        x: 120;
        y: 842;
        width: 1680;
        height: 145;
        content: "theorem lemma61_complex_with_dim (hn : n ≥ 1) (P : Polytope n) (s : ℂ) (hs : s ∈ RootSpace P)\n    (hleading : ∀ v ∈ P.vertices, 0 < v (Fin.last n)) : s.im ≠ 0 →\n    ∃ F, IsExposedFace P F ∧ s ∈ RootSpaceSet F ∧\n      Module.finrank ℝ (affineSpan ℝ F).direction ≤ 2";
        language: "lean";
        theme: "light";
        fontSize: 16;
        animate {
            id: "a518";
            effect: "fadeIn";
