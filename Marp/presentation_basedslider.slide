    text "e265" {
        x: 200;
        y: 268;
        width: 1520;
        height: 130;
        content: "Theorem (Edge Theorem). Let $\\Omega \\subset \\mathbb{R}^{n+1}$ be a polytope of polynomials satisfying Assumption 6.1. Then the boundary of $R(\\Omega)$ is contained in the root space of the exposed edges of $\\Omega$:";
        fontSize: 25;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
    }

    latex "e266" {
        x: 200;
        y: 424;
        width: 1520;
        height: 130;
        content: "\\partial R(\\Omega) \\;\\subseteq\\; \\bigcup_{E \\text{ exposed edge}} R(E)";
        fontSize: 44;
    }

    text "e267" {
        x: 120;
        y: 664;
        width: 1680;
        height: 120;
        content: "An infinite family of polynomials becomes finitely many one-parameter edge families — check the root space of each exposed edge, and stability of the whole polytope follows.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#5a6673";
    }
}

