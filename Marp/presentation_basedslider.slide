    text "e391" {
        x: 148;
        y: 192;
        width: 1640;
        height: 101;
        content: "Claim. Let $\\delta \\in P.\\Omega \\setminus \\mathrm{frontier}\\,P.\\Omega$, $v \\neq 0$, and $t_{\\mathrm{out}}$ with $\\delta + t_{\\mathrm{out}} \\bullet v \\notin P.\\Omega$. Then\n$\\exists\\,\\delta_{\\mathrm{bound}} \\in \\mathrm{segment} [ \\delta\\ ,(\\delta + t_{\\mathrm{out}} \\bullet v)$ ] with $\\delta_{\\mathrm{bound}} \\in \\mathrm{frontier}\\,P.\\Omega$.\nProof. A.2.1 Assume $\\Omega$ is closed and prove by contradiction (h_no_front : ∀ δ_bound ∈ segment ℝ δ (δ + t_out • v), δ_bound ∉ frontier P.Ω , and goal becomes false)\nA.2.2 The segment is then covered by the union of the two opens $\\mathrm{int}\\,\\Omega$ and $\\mathrm{int}(\\Omega^c)$. Points in $\\Omega$ off the frontier are interior since $\\Omega$ is";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a300";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e392" {
        x: 120;
        y: 322;
        width: 880;
        height: 702;
        content: "lemma segment_boundary_intersection {n : ℕ} (P : Polytope n) (δ : CoeffVec n)\n    (hδ_in_Ω : δ ∈ P.Ω) (hδ_not_front : δ ∉ frontier P.Ω)\n    (v : CoeffVec n) (_hv_nonzero : v ≠ 0) (t_out : ℝ) (ht_out : δ + t_out • v ∉ P.Ω) :\n    ∃ δ_bound ∈ segment ℝ δ (δ + t_out • v), δ_bound ∈ frontier P.Ω := by\n\n-- Step A.2.4\n  have h_conn : IsConnected (segment ℝ δ (δ + t_out • v)) :=\n    segment_is_connected δ v t_out\n\n-- Step A.2.1\n  have h_closed : IsClosed P.Ω := P.isCompact.isClosed\n  by_contra h_no_front\n  push_neg at h_no_front\n\n-- Step A.2.2\n  have h_cover : segment ℝ δ (δ + t_out • v) ⊆ (interior P.Ω) ∪ interior (P.Ωᶜ) :=\n    segment_cover_by_interior_and_complement P δ v t_out h_closed h_no_front\n\n-- Step A.2.3\n  have h_in_u : (segment ℝ δ (δ + t_out • v) ∩ interior P.Ω).Nonempty :=\n    segment_intersects_interior P δ v t_out hδ_in_Ω hδ_not_front h_closed\n  have h_in_v : (segment ℝ δ (δ + t_out • v) ∩ interior (P.Ωᶜ)).Nonempty :=\n    segment_intersects_complement_interior P δ v t_out ht_out h_closed\n  have huv_empty : interior P.Ω ∩ interior (P.Ωᶜ) = ∅ :=\n    interior_and_complement_interior_disjoint P\n\n-- Step A.2.4\n  have h_pre := h_conn.2 (interior P.Ω) (interior (P.Ωᶜ)) isOpen_interior isOpen_interior\n  have h_inter_nonempty := h_pre h_cover h_in_u h_in_v\n  obtain ⟨x, hx_s, hx_uv⟩ := h_inter_nonempty\n  rw [huv_empty] at hx_uv\n  exact hx_uv";
        language: "lean";
        theme: "light";
        fontSize: 13.5;
        animate {
            id: "a301";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

