    background: "#ffffff";

    text "e489" {
        x: 120;
        y: 56;
        width: 1700;
        height: 76;
        content: "Step 6: Degenerate cases — Lean + map";
        fontSize: 42;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e490" {
        x: 120;
        y: 148;
        width: 120;
        height: 6;
