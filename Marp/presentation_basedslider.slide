    html "e415" {
        x: 72;
        y: 140;
        width: 1776;
        height: 900;
        content: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>Step 3 — Escape: δ_bound ∈ U ∩ ∂Ω</title>\n<style>\n  :root{\n    --u:#3E7BE0; --d:#DD8A24; --a:#3FA46A; --o:#2F7D50;\n    --meet:#1B4F9C; --esc:#D2412F; --ink:#1D2430; --muted:#616B7A;\n    --bg:#FFFFFF; --rule:rgba(120,132,150,.28);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;background:var(--bg);color:var(--ink);\n    font:14px/1.5 ui-sans-serif,-apple-system,\"Segoe UI\",Roboto,sans-serif}\n  .wrap{max-width:1000px;margin:0 auto;padding:16px 18px 28px}\n  h1{font-size:16px;margin:0 0 3px;font-weight:650}\n  .sub{color:var(--muted);font-size:13px;margin:0 0 12px;max-width:82ch}\n  canvas{width:100%;height:560px;display:block;border-radius:12px;\n    border:1px solid var(--rule);background:#fff;touch-action:none;cursor:grab}\n  canvas.drag{cursor:grabbing}\n  .bar{display:flex;align-items:center;gap:14px;margin:12px 0 0;flex-wrap:wrap}\n  button{font:inherit;font-size:13px;padding:6px 13px;border-radius:8px;cursor:pointer;\n    border:1px solid var(--rule);background:#fff;color:var(--ink)}\n  button:hover{background:#F5F7FA}\n  button.primary{border-color:#B9CBE6;background:#EEF4FD}\n  .status{color:var(--muted);font-size:12.5px;font-variant-numeric:tabular-nums}\n  .steps{display:flex;gap:8px;margin:0 0 10px;flex-wrap:wrap}\n  button.step{padding:5px 12px;border-radius:999px;font-size:12.5px}\n  button.step.on{background:#EEF4FD;border-color:#B9CBE6;font-weight:650}\n  .cap{min-height:22px;color:#2A3442;font-size:13px;margin:10px 0 0}\n  .legend{display:flex;flex-wrap:wrap;gap:9px 20px;margin:13px 0 0;padding:0;\n    list-style:none;font-size:13px}\n  .legend li{display:flex;align-items:center;gap:7px;color:var(--ink)}\n  .sw{width:14px;height:14px;border-radius:3px;flex:0 0 auto;border:1px solid rgba(0,0,0,.16)}\n  .sw.line{height:4px;border-radius:2px;width:20px;border:0}\n  .note{color:var(--muted);font-size:12.5px;margin:11px 0 0;max-width:82ch}\n  .num{font-variant-numeric:tabular-nums}\n</style>\n<style>\n/* slide-embed overrides: fill the iframe, drop the page chrome the slide already has */\nhtml,body{height:100%;overflow:hidden;font-size:15px}\nmain,.wrap{max-width:1280px!important;width:100%!important;height:100%;margin:0 auto!important;\n  padding:12px 16px 10px!important;display:flex;flex-direction:column;gap:9px}\nheader{max-width:none!important}\nh1,.sub{display:none!important}\n.claim{margin:0!important;font-size:15px!important;line-height:1.45!important;max-width:none!important;padding:6px 11px!important}\n.layout{flex:1 1 auto;min-height:0;align-items:stretch!important;gap:16px!important}\n.fig{display:flex;flex-direction:column;flex:1 1 auto;min-height:0}\n/* height:0 + flex-grow makes the canvas take exactly the leftover box, so the\n   viewer's own resize() measures the same size it ends up painting into. */\ncanvas{flex:1 1 0!important;height:0!important;min-height:0!important;width:100%!important;\n  border-radius:10px!important}\n.bar{margin:0!important;flex:0 0 auto}\n.legend{margin:0!important;font-size:13.5px!important;max-width:none!important;flex:0 0 auto;gap:7px 18px!important}\n.note{margin:0!important;font-size:12.5px!important;line-height:1.4!important;max-width:none!important;flex:0 0 auto}\n.caption{margin:4px 0 0!important;min-height:0!important}\n#cap{font-size:13.5px!important;max-width:none!important}\n#lean{font-size:12px!important;max-width:none!important;margin:4px 0 0!important}\naside{flex:0 0 360px!important;position:static!important;min-height:0;display:flex;flex-direction:column}\n#steps{gap:5px!important;overflow:hidden}\nbutton.step{padding:5px 9px!important}\n.hint{margin:6px 0 0!important;font-size:11px!important}\nbutton{font-size:13.5px!important}\n#save{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <canvas id=\"c\" aria-label=\"Step 3 — Escape: δ_bound ∈ U ∩ ∂Ω\"></canvas>\n  <div class=\"bar\">\n    <button class=\"primary\" id=\"reset\">Reset view</button>\n    <button id=\"save\">Save PNG</button>\n    <span class=\"status\" id=\"status\">loading…</span>\n  </div>\n  <ul class=\"legend\">\n    <li><span class=\"sw\" style=\"background:var(--o)\"></span> Ω — the polytope</li>\n    <li><span class=\"sw\" style=\"background:var(--a);opacity:.35\"></span> aff Ω — its affine hull</li>\n    <li><span class=\"sw\" style=\"background:var(--u);opacity:.5\"></span> U — linear space through 0</li>\n    <li><span class=\"sw line\" style=\"background:var(--meet)\"></span> U ∩ aff Ω — the meet line</li>\n    <li><span class=\"sw line\" style=\"background:var(--esc)\"></span> δ + tv — the escape ray</li></ul>\n  <p class=\"note\">Worked in ℝ³: U = {δ₂ = 0}, aff Ω = {δ₂ = δ₀ + δ₁ + 2.4}, so U ∩ aff Ω is the line through δ in direction v = (1,−1,0). Ω is a hexagon inside aff Ω centred at (−1.2,−1.2,0). The segment leaves Ω at δ_bound = δ + (c·t_out)v with c = 0.75/1.9 ≈ 0.39 ∈ [0,1], and that point lies on an edge of Ω, i.e. on ∂Ω. Drag to rotate · scroll to zoom · press S to save a PNG.</p>\n</div>\n<script>\nwindow.CFG = {\n  scaleK: 0.185, az: -2.30, el: 0.58, center: [-1.05, -1.30, 0],\n  file: \"step3_escape.png\"\n};\n\nvar A = [1, 0, 1], B = [0, 1, 1], O = [-1.2, -1.2, 0];\nvar U1 = [0.70710678, 0, 0.70710678];\nvar U2 = [-0.40824829, 0.81649658, 0.40824829];\n\nfunction pt(x, y) {\n  return [O[0] + x * U1[0] + y * U2[0],\n          O[1] + x * U1[1] + y * U2[1],\n          O[2] + x * U1[2] + y * U2[2]];\n}\n\nvar RAD = 1.25, PHI = 0.30;\nvar HX2 = (function () {\n  var out = [];\n  for (var k = 0; k < 6; k++) {\n    var th = PHI + k * Math.PI / 3;\n    out.push([RAD * Math.cos(th), RAD * Math.sin(th)]);\n  }\n  return out;\n})();\nvar OMEGA = HX2.map(function (q) { return pt(q[0], q[1]); });\n\nvar D2 = [-0.31, 0.536936];\nvar V2 = [0.70710678, -1.22474487];\nvar DELTA = pt(D2[0], D2[1]);\n\nfunction along2(t) { return pt(D2[0] + t * V2[0], D2[1] + t * V2[1]); }\n\nvar EXIT = (function () {\n  var best = Infinity;\n  for (var i = 0; i < 6; i++) {\n    var p = HX2[i], q = HX2[(i + 1) % 6];\n    var ex = q[0] - p[0], ey = q[1] - p[1];\n    var det = -V2[0] * ey + ex * V2[1];\n    if (Math.abs(det) < 1e-12) continue;\n    var rx = p[0] - D2[0], ry = p[1] - D2[1];\n    var t = (-rx * ey + ex * ry) / det;\n    var s = (V2[0] * ry - rx * V2[1]) / det;\n    if (t > 1e-9 && s >= -1e-9 && s <= 1 + 1e-9 && t < best) best = t;\n  }\n  return best;\n})();\n\nvar T_OUT = EXIT + 0.55;\nvar DBOUND = along2(EXIT);\nvar POUT = along2(T_OUT);\nvar C_FRAC = EXIT / T_OUT;\n\nfunction patch2(r) {\n  return [[r, r], [r, -r], [-r, -r], [-r, r]].map(function (s) {\n    return pt(s[0], s[1]);\n  });\n}\n\nvar U_PATCH = [[-2.95, -3.35, 0], [1.05, -3.35, 0], [1.05, 0.75, 0], [-2.95, 0.75, 0]];\nvar AFF_PATCH = patch2(1.62);\n\nwindow.CHECK = {\n  c: C_FRAC, exitT: EXIT, tOut: T_OUT,\n  deltaZ: DELTA[2], dboundZ: DBOUND[2], poutZ: POUT[2],\n  deltaRadius: Math.hypot(D2[0], D2[1]), hexRadius: RAD\n};\n\nwindow.build = function () {\n  poly(U_PATCH, \"rgba(62,123,224,.10)\", \"rgba(62,123,224,.45)\", 1.1, 6);\n  poly(AFF_PATCH, \"rgba(63,164,106,.09)\", \"rgba(63,164,106,.45)\", 1.1, 5);\n\n  line([along2(-1.9), along2(1.9)], \"#1B4F9C\", 2.2, [7, 5], 0);\n  poly(OMEGA, \"rgba(63,164,106,.42)\", \"#2F7D50\", 2.4, 3);\n\n  line([DELTA, POUT], \"#D2412F\", 2.6, [], -4);\n  arrow(DELTA, along2(0.55), \"#2F63BE\", 3.4);\n\n  dot(POUT, \"#ffffff\", 5.2, \"#D2412F\");\n  dot(DBOUND, \"#8E2318\", 6.2, \"#ffffff\");\n  dot(DELTA, \"#D2412F\", 6.6);\n\n  label(DELTA, \"δ\", \"#B3301F\", -16, -10);\n  label(DBOUND, \"δ_bound = δ + (c·t_out)v ∈ ∂Ω\", \"#7A1E14\", 12, 19);\n  label(POUT, \"δ + t_out v ∉ Ω\", \"#B3301F\", 12, -8);\n  label(along2(-1.35), \"δ + ℝv ⊆ U ∩ aff Ω\", \"#1B4F9C\", -14, -12);\n  label(along2(0.32), \"v\", \"#2F63BE\", -3, -13);\n  label(OMEGA[1], \"Ω\", \"#1F5C3A\", 10, 4);\n  label(U_PATCH[0], \"U\", \"#2F63BE\", 6, -8);\n  label(AFF_PATCH[0], \"aff Ω\", \"#2F7D50\", 4, -9);\n\n  document.getElementById(\"status\").textContent =\n    \"dim(U ∩ dir(aff Ω)) = 1 · exit at t = \" + EXIT.toFixed(2) +\n    \" · c = \" + C_FRAC.toFixed(3) + \" ∈ [0,1]\";\n};\n</script>\n<script>\n(function () {\n  \"use strict\";\n  var CFG = window.CFG || {};\n  var cv = document.getElementById(\"c\");\n  var ctx = cv.getContext(\"2d\");\n  var W = 0, H = 0, DPR = 1, items = [];\n\n  var az = CFG.az !== undefined ? CFG.az : -2.36;\n  var el = CFG.el !== undefined ? CFG.el : 0.62;\n  var zoom = CFG.zoom !== undefined ? CFG.zoom : 1;\n  var K = CFG.scaleK !== undefined ? CFG.scaleK : 0.15;\n  var CEN = CFG.center || [0, 0, 0];\n  var HOME = { az: az, el: el, zoom: zoom };\n  var cam = { f: [0, 0, 1], r: [1, 0, 0], u: [0, 1, 0] };\n\n  function updateCamera() {\n    var fx = Math.cos(el) * Math.cos(az), fy = Math.cos(el) * Math.sin(az), fz = Math.sin(el);\n    cam.f = [fx, fy, fz];\n    var rn = Math.hypot(-fy, fx) || 1;\n    cam.r = [-fy / rn, fx / rn, 0];\n    cam.u = [fy * 0 - fz * cam.r[1], fz * cam.r[0] - fx * 0, fx * cam.r[1] - fy * cam.r[0]];\n  }\n\n  function project(p) {\n    var qx = p[0] - CEN[0], qy = p[1] - CEN[1], qz = p[2] - CEN[2];\n    var xc = qx * cam.r[0] + qy * cam.r[1] + qz * cam.r[2];\n    var yc = qx * cam.u[0] + qy * cam.u[1] + qz * cam.u[2];\n    var d = -(qx * cam.f[0] + qy * cam.f[1] + qz * cam.f[2]);\n    var s = Math.min(W, H) * K * zoom;\n    return { x: W / 2 + xc * s, y: H / 2 - yc * s, z: d };\n  }\n  window.project = project;\n\n  function poly(points, fill, stroke, lw, shift) {\n    var pr = points.map(project);\n    var d = pr.reduce(function (t, p) { return t + p.z; }, 0) / pr.length + (shift || 0);\n    items.push({ depth: d, draw: function () {\n      ctx.beginPath();\n      pr.forEach(function (p, i) { i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); });\n      ctx.closePath();\n      if (fill) { ctx.fillStyle = fill; ctx.fill(); }\n      if (stroke) {\n        ctx.strokeStyle = stroke; ctx.lineWidth = lw || 1; ctx.lineJoin = \"round\"; ctx.stroke();\n      }\n    }});\n  }\n\n  function line(pts, color, width, dash, shift) {\n    var pr = pts.map(project);\n    var d = pr.reduce(function (t, p) { return t + p.z; }, 0) / pr.length + (shift || 0);\n    items.push({ depth: d, draw: function () {\n      ctx.save();\n      ctx.beginPath();\n      pr.forEach(function (p, i) { i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); });\n      ctx.setLineDash(dash || []);\n      ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = \"round\";\n      ctx.stroke();\n      ctx.restore();\n    }});\n  }\n\n  function dot(p, color, r, ring) {\n    var q = project(p);\n    items.push({ depth: q.z - 40, draw: function () {\n      ctx.beginPath(); ctx.arc(q.x, q.y, r, 0, Math.PI * 2);\n      ctx.fillStyle = color; ctx.fill();\n      ctx.lineWidth = ring ? 2 : 1.2;\n      ctx.strokeStyle = ring || \"rgba(255,255,255,.9)\";\n      ctx.stroke();\n    }});\n  }\n\n  function label(p, text, color, dx, dy, size, weight) {\n    var q = project(p);\n    items.push({ depth: q.z - 500, draw: function () {\n      ctx.font = (weight || 600) + \" \" + (size || 12.5) +\n        \"px ui-sans-serif,-apple-system,Segoe UI,Roboto,sans-serif\";\n      var w = ctx.measureText(text).width;\n      var x = q.x + (dx || 10), y = q.y + (dy || -10);\n      ctx.fillStyle = \"rgba(255,255,255,.88)\";\n      ctx.fillRect(x - 3, y - 12, w + 6, 16);\n      ctx.fillStyle = color;\n      ctx.fillText(text, x, y);\n    }});\n  }\n\n  function arrow(p0, p1, color, width) {\n    var a = project(p0), b = project(p1);\n    items.push({ depth: (a.z + b.z) / 2 - 30, draw: function () {\n      var ang = Math.atan2(b.y - a.y, b.x - a.x), h = 10, w = 4.8;\n      ctx.strokeStyle = color; ctx.lineWidth = width || 2.4; ctx.lineCap = \"round\";\n      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(b.x, b.y);\n      ctx.lineTo(b.x - h * Math.cos(ang - 0.42), b.y - h * Math.sin(ang - 0.42));\n      ctx.lineTo(b.x - h * Math.cos(ang + 0.42), b.y - h * Math.sin(ang + 0.42));\n      ctx.closePath(); ctx.fillStyle = color; ctx.fill();\n    }});\n  }\n\n  function circle(c, e1, e2, rad, color, dash, width, shift) {\n    var pts = [];\n    for (var i = 0; i <= 120; i++) {\n      var t = i / 120 * Math.PI * 2, ct = Math.cos(t), st = Math.sin(t);\n      pts.push([\n        c[0] + rad * (ct * e1[0] + st * e2[0]),\n        c[1] + rad * (ct * e1[1] + st * e2[1]),\n        c[2] + rad * (ct * e1[2] + st * e2[2])\n      ]);\n    }\n    line(pts, color, width || 1.4, dash || [5, 5], shift);\n  }\n\n  window.poly = poly; window.line = line; window.dot = dot;\n  window.label = label; window.arrow = arrow; window.circle = circle;\n\n  function render() {\n    updateCamera();\n    ctx.clearRect(0, 0, W, H);\n    items = [];\n    if (typeof window.build === \"function\") window.build();\n    items.sort(function (a, b) { return b.depth - a.depth; });\n    items.forEach(function (it) { it.draw(); });\n  }\n  window.render = render;\n\n  function resize() {\n    DPR = Math.min(window.devicePixelRatio || 1, 2);\n    var r = cv.getBoundingClientRect();\n    W = Math.max(320, Math.round(r.width));\n    H = Math.max(280, Math.round(r.height));\n    cv.width = Math.round(W * DPR);\n    cv.height = Math.round(H * DPR);\n    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);\n    render();\n  }\n\n  var dragging = false, lastX = 0, lastY = 0;\n  cv.addEventListener(\"pointerdown\", function (e) {\n    dragging = true; lastX = e.clientX; lastY = e.clientY;\n    cv.classList.add(\"drag\"); cv.setPointerCapture(e.pointerId);\n  });\n  cv.addEventListener(\"pointermove\", function (e) {\n    if (!dragging) return;\n    az -= (e.clientX - lastX) * 0.008;\n    el += (e.clientY - lastY) * 0.006;\n    el = Math.max(-1.32, Math.min(1.32, el));\n    lastX = e.clientX; lastY = e.clientY;\n    render();\n  });\n  function endDrag(e) {\n    dragging = false; cv.classList.remove(\"drag\");\n    if (e && e.pointerId !== undefined && cv.hasPointerCapture(e.pointerId)) {\n      cv.releasePointerCapture(e.pointerId);\n    }\n  }\n  cv.addEventListener(\"pointerup\", endDrag);\n  cv.addEventListener(\"pointercancel\", endDrag);\n  cv.addEventListener(\"wheel\", function (e) {\n    e.preventDefault();\n    zoom = Math.max(0.4, Math.min(3.5, zoom * Math.exp(-e.deltaY * 0.0012)));\n    render();\n  }, { passive: false });\n\n  function resetView() {\n    az = HOME.az; el = HOME.el; zoom = HOME.zoom; render();\n  }\n\n  document.getElementById(\"reset\").addEventListener(\"click\", resetView);\n\n  function savePNG() {\n    var out = document.createElement(\"canvas\");\n    out.width = cv.width; out.height = cv.height;\n    var o = out.getContext(\"2d\");\n    o.fillStyle = \"#fff\"; o.fillRect(0, 0, out.width, out.height);\n    o.drawImage(cv, 0, 0);\n    var a = document.createElement(\"a\");\n    a.download = CFG.file || \"figure.png\";\n    a.href = out.toDataURL(\"image/png\");\n    a.click();\n  }\n  document.getElementById(\"save\").addEventListener(\"click\", savePNG);\n\n  window.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"s\" || e.key === \"S\") savePNG();\n    if (e.key === \"r\" || e.key === \"R\") resetView();\n  });\n\n  window.addEventListener(\"resize\", resize);\n  resize();\n})();\n</script>\n<script>\n(function(){\n  var c=document.getElementById('c'); if(!c) return;\n  function fix(){ try { window.dispatchEvent(new Event('resize')); } catch(e){} }\n  if (window.ResizeObserver) { new ResizeObserver(fix).observe(c); }\n  window.addEventListener('load', fix);\n  setTimeout(fix, 60); setTimeout(fix, 300); setTimeout(fix, 900);\n  // Optional nudge: one wheel notch so the drawing uses more of the box.\n  var zoomIn = 1.0;\n  if (Math.abs(zoomIn - 1) > 0.01) {\n    setTimeout(function(){\n      c.dispatchEvent(new WheelEvent('wheel', {\n        deltaY: -Math.log(zoomIn) / 0.0012, bubbles: true, cancelable: true\n      }));\n    }, 1000);\n  }\n})();\n</script>\n</body>\n</html>\n";
        radius: 10;
    }
}

slide "Step 4: Exposed face — Lean + map (1/2)" {
    id: "s40";
    background: "#ffffff";

    text "e416" {
        x: 120;
        y: 56;
        width: 1700;
        height: 76;
        content: "Step 4: Exposed face — Lean + map";
        fontSize: 42;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e417" {
        x: 120;
        y: 148;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e418" {
        x: 120;
        y: 176;
        width: 1680;
        height: 130;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a319";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e419" {
        x: 120;
        y: 176;
        width: 8;
        height: 130;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a320";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e420" {
        x: 148;
        y: 192;
        width: 1640;
        height: 101;
        content: "Claim. Let $\\delta_{\\mathrm{bound}} \\in \\mathrm{frontier}\\,P.\\Omega \\cap \\mathrm{PsrSet}\\,n\\,r = =\\; \\{\\,\\delta \\in \\mathbb{R}^{n+1} \\mid P_\\delta(r) = 0\\,\\} $ $\\;=\\;$\n$ \\{\\,\\delta \\mid \\delta_0 + \\delta_1 r + \\cdots + \\delta_n r^n = 0\\,\\}$\nwith $(\\mathrm{interior}\\,P.\\Omega).\\mathrm{Nonempty}$. Then there exists $F$ with\n$\\mathrm{IsExposedFace}\\,P\\,F \\land \\delta_{\\mathrm{bound}} \\in F \\land (r:\\mathbb{C}) \\in \\mathrm{RootSpaceSet}\\,F$.";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a321";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e421" {
        x: 120;
        y: 322;
        width: 880;
        height: 720;
        content: "lemma exists_exposed_face_containing_boundary_point {n : ℕ} (P : Polytope n)\n    (r : ℝ) (δ_bound : CoeffVec n)\n    (hδ_bound_front : δ_bound ∈ frontier P.Ω)\n    (hδ_bound_Psr : δ_bound ∈ PsrSet n r)\n    (h_int_nonempty : (interior P.Ω).Nonempty) :\n    ∃ F : Set (CoeffVec n), IsExposedFace P F ∧ δ_bound ∈ F ∧ (r : ℂ) ∈ RootSpaceSet F := by\n\n-- Step 4.1\n  have hδ_bound_in_Ω : δ_bound ∈ P.Ω := frontier_point_in_Ω P δ_bound hδ_bound_front\n  have hδ_bound_not_int : δ_bound ∉ interior P.Ω :=\n    frontier_point_not_interior P δ_bound hδ_bound_front\n\n-- Step 4.2\n  have h_convex : Convex ℝ P.Ω := convex_convexHull ℝ _\n  have h_int_convex : Convex ℝ (interior P.Ω) := h_convex.interior\n  have h_int_open : IsOpen (interior P.Ω) := isOpen_interior\n\n-- Step 4.3\n  obtain ⟨f, hf_strict⟩ :=\n    geometric_hahn_banach_open_point h_int_convex h_int_open hδ_bound_not_int\n\n-- Step 4.4\n  have hf_ne : f ≠ 0 := supporting_func_nonzero P f δ_bound hf_strict h_int_nonempty\n\n-- Step 4.5\n  let c : ℝ := f δ_bound\n\n-- Step 4.4\n  let f_lin : CoeffVec n →ₗ[ℝ] ℝ := f.toLinearMap\n  have hf_lin_ne : f_lin ≠ 0 := by\n    intro heq\n    apply hf_ne\n    ext x\n    have : f_lin x = 0 := by\n      rw [heq]\n      simp\n    exact this";
        language: "lean";
        theme: "light";
        fontSize: 12;
        animate {
            id: "a322";
            effect: "fadeIn";
