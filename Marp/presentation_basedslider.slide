            direction: "up";
            repeat: 1;
        }
    }

    text "e147" {
        x: 156;
        y: 218;
        width: 1600;
        height: 34;
        content: "Definition (Affine subspace)";
        fontSize: 23;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a120";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e148" {
        x: 156;
        y: 256;
        width: 1600;
        height: 100;
        content: "$A \\subseteq \\mathbb{R}^d$ is affine iff for all $x,y \\in A$ and all $t \\in \\mathbb{R}$ we have $(1-t)x + ty \\in A$ — closed under lines. Equivalently $A = p + V$ for $p \\in A$ and a linear subspace $V = \\operatorname{dir}(A)$.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a121";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e149" {
        x: 120;
        y: 392;
        width: 1680;
        height: 150;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a122";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e150" {
        x: 156;
        y: 414;
        width: 1600;
        height: 34;
        content: "Definition (Affine span)";
        fontSize: 23;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a123";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e151" {
        x: 156;
        y: 452;
        width: 1600;
        height: 70;
        content: "For $S \\subseteq \\mathbb{R}^d$, $\\operatorname{aff}(S) = \\bigcap \\{A \\mid A \\text{ affine and } S \\subseteq A\\}$ — the smallest affine subspace containing $S$.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a124";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e152" {
        x: 120;
        y: 558;
        width: 1680;
        height: 150;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a125";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e153" {
        x: 156;
        y: 580;
        width: 1600;
        height: 34;
        content: "Definition (Direction)";
        fontSize: 23;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a126";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e154" {
        x: 156;
        y: 618;
        width: 1600;
        height: 70;
        content: "For an affine subspace $A$, $\\operatorname{dir}(A) = \\{v \\mid \\forall p \\in A,\\ p + v \\in A\\}$ — the linear subspace of translations that preserve $A$.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a127";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e155" {
        x: 120;
        y: 724;
        width: 1680;
        height: 200;
        fill: "#f2f6fa";
        radius: 10;
        animate {
            id: "a128";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e156" {
        x: 120;
        y: 724;
        width: 8;
        height: 200;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a129";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e157" {
        x: 156;
        y: 746;
        width: 1600;
        height: 34;
        content: "Definition (Dimension)";
        fontSize: 23;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a130";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e158" {
        x: 156;
        y: 784;
        width: 1600;
        height: 120;
        content: "For a linear subspace $U \\subseteq \\mathbb{R}^d$, $\\dim U$ is the number of vectors in any basis, i.e. the maximal size of a linearly independent subset of $U$. For an affine subspace define $\\dim A := \\dim \\operatorname{dir}(A)$ — so $\\dim \\operatorname{aff}(F) = 0$ is a point, $= 1$ a line, $= 2$ a plane.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a131";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "Affine span, direction, dimension — Lean" {
    id: "s15";
    background: "#ffffff";

    text "e159" {
        x: 120;
        y: 64;
        width: 1700;
        height: 90;
        content: "Affine span, direction, dimension — Lean";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e160" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e161" {
        x: 120;
        y: 196;
        width: 1680;
        height: 460;
        fill: "#f2f6fa";
        radius: 8;
    }

    text "e162" {
        x: 160;
        y: 218;
        width: 1600;
        height: 40;
        content: "For a linear subspace $U \\subseteq \\mathbb{R}^{n+1}$ and an affine subspace $A \\subseteq \\mathbb{R}^{n+1}$:";
        fontSize: 23;
        color: "#24313f";
        math: true;
    }

    latex "e163" {
        x: 160;
        y: 270;
        width: 1600;
        height: 90;
        content: "\\operatorname{meetDir}(U, A) := \\operatorname{dir}\\big(\\operatorname{aff}(U \\cap A)\\big) \\;\\overset{U \\cap A \\neq \\varnothing}{=}\\; U \\cap \\operatorname{dir}(A)";
        fontSize: 30;
    }

    latex "e164" {
        x: 160;
        y: 372;
        width: 1600;
        height: 70;
        content: "\\dim U := \\dim_{\\mathbb{R}} U = \\operatorname{finrank}_{\\mathbb{R}}(U), \\qquad \\dim(\\mathbb{R}^{n+1}) = n + 1";
        fontSize: 26;
    }

    text "e165" {
        x: 160;
        y: 456;
        width: 1600;
        height: 70;
        content: "The direction identity holds because $U$, viewed as an affine subspace, has direction $U$ itself (intersection_direction_eq).";
        fontSize: 21;
        lineHeight: 1.4;
        color: "#24313f";
        math: true;
    }

    latex "e166" {
        x: 160;
        y: 540;
        width: 1600;
        height: 90;
        content: "\\dim\\big(\\operatorname{meetDir}(U, A)\\big) = \\dim\\big(U \\cap \\operatorname{dir}(A)\\big) \\;\\ge\\; n + 2 - (n+1) = 1";
        fontSize: 26;
    }

    code "e167" {
        x: 120;
        y: 686;
        width: 1680;
        height: 300;
        content: "abbrev meetDir (n : ℕ) (U : Submodule ℝ (CoeffVec n))\n    (affΩ : AffineSubspace ℝ (CoeffVec n)) : Submodule ℝ (CoeffVec n) :=\n  (affineSpan ℝ ((U : Set (CoeffVec n)) ∩ (affΩ : Set (CoeffVec n)))).direction\n\nnoncomputable abbrev dim {M : Type*} [AddCommGroup M] [Module ℝ M]\n    (U : Submodule ℝ M) : ℕ :=\n  Module.finrank ℝ U";
        language: "lean";
        theme: "light";
        fontSize: 16;
    }
}

