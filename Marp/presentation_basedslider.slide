slide "Boundary and exposed faces — Lean" {
    id: "s21";
    background: "#ffffff";

    text "e213" {
        x: 120;
        y: 64;
        width: 1700;
        height: 90;
        content: "Boundary and exposed faces — Lean";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e214" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    code "e215" {
        x: 120;
        y: 200;
        width: 1680;
        height: 420;
        content: "/-- The exposed face of `P` for `hp`: `F = Ω ∩ {x | hp.f x = hp.c}`. -/\ndef ExposedFace {n : ℕ} {P : Polytope n} (hp : SupportingHyperplane P) :\n    Set (CoeffVec n) :=\n  { x | x ∈ P.Ω ∧ hp.f x = hp.c }\n\nopen Affine\n\n/-- `E` is an exposed edge of `P` if it is an exposed face of affine dimension 1. -/\ndef IsExposedEdge {n : ℕ} (P : Polytope n) (E : Set (CoeffVec n)) : Prop :=\n  ∃ hp : SupportingHyperplane P,\n    E = ExposedFace hp ∧\n    Module.finrank ℝ (affineSpan ℝ (ExposedFace hp)).direction = 1";
        language: "lean";
        theme: "light";
        fontSize: 16;
    }

    text "e216" {
        x: 120;
        y: 652;
        width: 1680;
        height: 90;
        content: "ExposedFace is $\\Omega \\cap \\{f = c\\}$; an exposed edge is the same construction with affine dimension $1$. Both are plain definitions over a polytope and one of its supporting hyperplanes.";
        fontSize: 23;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
    }
}

