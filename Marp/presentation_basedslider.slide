slide "What is a control system?" {
    id: "s3";
    background: "#ffffff";

    text "e28" {
        x: 120;
        y: 64;
        width: 1400;
        height: 90;
        content: "What is a control system?";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e29" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e30" {
        x: 120;
        y: 210;
        width: 1680;
        height: 160;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a25";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e31" {
        x: 120;
        y: 210;
        width: 8;
        height: 160;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a26";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e32" {
        x: 166;
        y: 236;
        width: 1600;
        height: 120;
        content: "A control system manages, commands, directs, or regulates the behavior of other devices or systems using control loops - from simple applications like a home thermostat to complex industrial processes.";
        fontSize: 28;
        lineHeight: 1.45;
        color: "#24313f";
        animate {
            id: "a27";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e33" {
        x: 120;
        y: 410;
        width: 800;
        height: 430;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a28";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e34" {
        x: 156;
        y: 436;
        width: 730;
        height: 46;
        content: "Continuous-time state-space model:";
        fontSize: 27;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a29";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e35" {
        x: 156;
        y: 520;
        width: 730;
        height: 110;
        content: "\\dot{x}(t) = A x(t) + B u(t)";
        fontSize: 34;
        animate {
            id: "a30";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e36" {
        x: 156;
        y: 670;
        width: 730;
        height: 110;
        content: "y(t) = C x(t) + D u(t)";
        fontSize: 34;
        animate {
            id: "a31";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e37" {
        x: 1000;
        y: 410;
        width: 800;
        height: 430;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a32";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e38" {
        x: 1036;
        y: 436;
        width: 730;
        height: 46;
        content: "Discrete-time state-space model:";
        fontSize: 27;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a33";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e39" {
        x: 1036;
        y: 520;
        width: 730;
        height: 110;
        content: "x[k+1] = A_d x[k] + B_d u[k]";
        fontSize: 34;
        animate {
            id: "a34";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e40" {
        x: 1036;
        y: 670;
        width: 730;
        height: 110;
        content: "y[k] = C_d x[k] + D_d u[k]";
        fontSize: 34;
        animate {
            id: "a35";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e41" {
        x: 120;
        y: 880;
        width: 1680;
        height: 150;
        content: "Where: $x$ is the state vector, $y$ the output vector, $u$ the input (control) vector, and $A$, $B$, $C$, $D$ the state, input, output and feedthrough matrices respectively.";
        fontSize: 27;
        lineHeight: 1.6;
        color: "#24313f";
        math: true;
        animate {
            id: "a36";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "From state-space to transfer function" {
    id: "s4";
    background: "#ffffff";

    text "e42" {
        x: 120;
        y: 64;
        width: 1600;
        height: 90;
        content: "From state-space to transfer function";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e43" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    text "e44" {
        x: 120;
        y: 212;
        width: 1680;
        height: 90;
        content: "Starting from $\\dot{x}(t) = A x(t) + B u(t)$, $y(t) = C x(t) + D u(t)$, with zero initial conditions ($x(0) = 0$):";
        fontSize: 28;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a37";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e45" {
        x: 120;
        y: 330;
        width: 1680;
        height: 400;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a38";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e46" {
        x: 156;
        y: 360;
        width: 1200;
        height: 44;
        content: "Applying the Laplace transform:";
        fontSize: 26;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a39";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e47" {
        x: 156;
        y: 420;
        width: 1600;
        height: 90;
        content: "s X(s) = A X(s) + B U(s), \\qquad Y(s) = C X(s) + D U(s)";
        displayMode: false;
        fontSize: 30;
        animate {
            id: "a40";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e48" {
        x: 156;
        y: 520;
        width: 1600;
        height: 90;
        content: "(sI - A) X(s) = B U(s) \\qquad\\Longrightarrow\\qquad X(s) = (sI - A)^{-1} B U(s)";
        displayMode: false;
        fontSize: 30;
        animate {
            id: "a41";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e49" {
        x: 156;
        y: 620;
        width: 1600;
        height: 90;
        content: "\\Longrightarrow\\quad Y(s) = C (sI - A)^{-1} B U(s) + D U(s)";
        displayMode: false;
        fontSize: 30;
        animate {
            id: "a42";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e50" {
        x: 120;
        y: 780;
        width: 1680;
        height: 230;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a43";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e51" {
        x: 120;
        y: 780;
        width: 8;
        height: 230;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a44";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e52" {
        x: 170;
        y: 800;
        width: 1580;
        height: 110;
        content: "G(s) = \\dfrac{Y(s)}{U(s)} = C (sI - A)^{-1} B + D";
        fontSize: 42;
        animate {
            id: "a45";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e53" {
        x: 170;
        y: 920;
        width: 1580;
        height: 50;
        content: "the transfer function";
        fontSize: 26;
        fontWeight: 600;
        align: "center";
        color: "#1f4e79";
        animate {
            id: "a46";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "Example: mass-spring-damper" {
    id: "s5";
    background: "#ffffff";

    text "e54" {
        x: 120;
        y: 64;
        width: 1600;
        height: 90;
        content: "Example: mass-spring-damper";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e55" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    text "e56" {
        x: 120;
        y: 196;
        width: 1680;
        height: 88;
        content: "$m = 1\\,\\mathrm{kg}$, $c = 2\\,\\mathrm{N{\\cdot}s/m}$, $k = 3\\,\\mathrm{N/m}$; input $u(t)$ = force (N), output $y(t)$ = displacement (m).";
        fontSize: 26;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a47";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e57" {
        x: 120;
        y: 292;
        width: 1680;
        height: 96;
        content: "m\\ddot{y} + c\\dot{y} + k y = u(t) \\qquad\\Rightarrow\\qquad \\ddot{y} + 2\\dot{y} + 3y = u(t)";
        fontSize: 34;
        animate {
            id: "a48";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e58" {
        x: 120;
        y: 402;
        width: 1680;
        height: 46;
        content: "States $x_1 = y$ (position), $x_2 = \\dot{y}$ (velocity):";
        fontSize: 26;
        color: "#24313f";
        math: true;
        animate {
            id: "a49";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e59" {
        x: 120;
        y: 458;
        width: 1680;
        height: 196;
        content: "\\begin{cases} \\dot{x}_1 = x_2 \\\\ \\dot{x}_2 = -3x_1 - 2x_2 + u \\end{cases} \\qquad\\Rightarrow\\qquad A = \\begin{bmatrix} 0 & 1 \\\\ -3 & -2 \\end{bmatrix},\\; B = \\begin{bmatrix} 0 \\\\ 1 \\end{bmatrix},\\; C = \\begin{bmatrix} 1 & 0 \\end{bmatrix},\\; D = 0";
        fontSize: 30;
        animate {
            id: "a50";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e60" {
        x: 120;
        y: 696;
        width: 1680;
        height: 258;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a51";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e61" {
        x: 120;
        y: 696;
        width: 8;
        height: 258;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a52";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e62" {
        x: 160;
        y: 726;
        width: 1600;
        height: 198;
        content: "G(s) = C(sI-A)^{-1}B + D = \\begin{bmatrix} 1 & 0 \\end{bmatrix} \\frac{1}{s^2+2s+3} \\begin{bmatrix} s+2 & 1 \\\\ -3 & s \\end{bmatrix} \\begin{bmatrix} 0 \\\\ 1 \\end{bmatrix} = \\dfrac{1}{s^2+2s+3}";
        animate {
            id: "a53";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "Poles and stability" {
    id: "s6";
    background: "#ffffff";

    text "e63" {
        x: 120;
        y: 64;
        width: 1400;
        height: 90;
        content: "Poles and stability";
        fontSize: 54;
