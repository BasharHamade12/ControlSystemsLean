        }
    }

    text "e294" {
        x: 130;
        y: 592;
        width: 990;
        height: 90;
        content: "3. Escape. Follow the nonzero direction to\n$\\delta_{\\mathrm{bound}} \\in P_{s_r} \\cap \\partial\\Omega$.";
        fontSize: 21;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a223";
