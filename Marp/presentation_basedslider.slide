slide "Kharitonov's theorem" {
    id: "s7";
    background: "#ffffff";

    text "e78" {
        x: 120;
        y: 64;
        width: 1400;
        height: 90;
        content: "Kharitonov's theorem";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e79" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e80" {
        x: 120;
        y: 196;
        width: 1680;
        height: 404;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a67";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e81" {
        x: 120;
        y: 196;
        width: 8;
        height: 404;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a68";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e82" {
        x: 160;
        y: 214;
        width: 1600;
        height: 80;
        content: "Interval family $\\mathcal{P} = \\{p(s) = a_n s^n + \\cdots + a_1 s + a_0 \\mid a_i \\in [\\underline{a}_i, \\bar{a}_i],\\ \\bar{a}_n > 0\\}$, with four vertex polynomials:";
        fontSize: 25;
        color: "#24313f";
        math: true;
        animate {
            id: "a69";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    latex "e83" {
        x: 200;
        y: 300;
        width: 1520;
        height: 210;
        content: "\\begin{aligned} K_1 &= \\underline{a}_n s^n + \\underline{a}_{n-1}s^{n-1} + \\bar{a}_{n-2}s^{n-2} + \\bar{a}_{n-3}s^{n-3} + \\cdots \\\\ K_2 &= \\bar{a}_n s^n + \\bar{a}_{n-1}s^{n-1} + \\underline{a}_{n-2}s^{n-2} + \\underline{a}_{n-3}s^{n-3} + \\cdots \\\\ K_3 &= \\underline{a}_n s^n + \\bar{a}_{n-1}s^{n-1} + \\bar{a}_{n-2}s^{n-2} + \\underline{a}_{n-3}s^{n-3} + \\cdots \\\\ K_4 &= \\bar{a}_n s^n + \\underline{a}_{n-1}s^{n-1} + \\underline{a}_{n-2}s^{n-2} + \\bar{a}_{n-3}s^{n-3} + \\cdots \\end{aligned}";
        fontSize: 28;
        animate {
            id: "a70";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e84" {
        x: 160;
        y: 520;
        width: 1600;
        height: 60;
        content: "$\\mathcal{P}$ is Hurwitz stable $\\iff$ $K_1, K_2, K_3, K_4$ are each Hurwitz stable.";
        fontSize: 26;
        color: "#12233a";
        math: true;
        animate {
            id: "a71";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e85" {
        x: 120;
        y: 636;
        width: 1140;
        height: 210;
        content: "Example (primary structure + TMD). Primary: $m_1 \\in [\\underline{m}_1, \\bar{m}_1]$, $k_1 \\in [\\underline{k}_1, \\bar{k}_1]$, $c_1 \\in [\\underline{c}_1, \\bar{c}_1]$; tuned mass damper: $m_2 \\in [\\underline{m}_2, \\bar{m}_2]$, $k_2 \\in [\\underline{k}_2, \\bar{k}_2]$, $c_2 \\in [\\underline{c}_2, \\bar{c}_2]$. The equations of motion give $p(s) = a_4 s^4 + a_3 s^3 + a_2 s^2 + a_1 s + a_0 = 0$ with $a_i \\in [\\underline{a}_i, \\bar{a}_i]$ — an interval family, so these four polynomials decide its stability.";
        fontSize: 24;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a72";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    image "e86" {
        x: 1310;
        y: 660;
        width: 470;
        height: 221;
        src: "data:image/png;base64,";
        animate {
            id: "a73";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "Kharitonov vs Edge Theorem (discrete systems)" {
    id: "s8";
    background: "#ffffff";

    text "e87" {
        x: 120;
        y: 64;
        width: 1650;
        height: 90;
        content: "Kharitonov vs Edge Theorem (discrete systems)";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e88" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    rect "e89" {
        x: 120;
        y: 200;
        width: 800;
        height: 620;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a74";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e90" {
        x: 152;
        y: 228;
        width: 736;
        height: 40;
        content: "Why Kharitonov fails (discrete)";
        fontSize: 26;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a75";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e91" {
        x: 152;
        y: 292;
        width: 736;
        height: 180;
        content: "• Kharitonov's proof relies on a special even/odd symmetry of the imaginary axis. The unit circle has no such symmetry, so four stable corner polynomials prove nothing — an unstable member can still hide in the family.";
        fontSize: 22;
        lineHeight: 1.45;
        color: "#24313f";
        animate {
            id: "a76";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e92" {
        x: 152;
        y: 500;
        width: 736;
        height: 110;
        content: "• A bilinear map sends the disc to the half-plane, but it mixes all coefficients together.";
        fontSize: 22;
        lineHeight: 1.45;
        color: "#24313f";
        animate {
            id: "a77";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e93" {
        x: 1000;
        y: 200;
        width: 800;
        height: 620;
        fill: "#f8f9fa";
        stroke: "#d0d7de";
        strokeWidth: 1;
        radius: 10;
        animate {
            id: "a78";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e94" {
        x: 1032;
        y: 228;
        width: 736;
        height: 40;
        content: "Counterexample: Kharitonov fails (discrete)";
        fontSize: 26;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a79";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e95" {
        x: 1032;
        y: 292;
        width: 736;
        height: 140;
        content: "• Interval family $p(z) = a_3 z^3 + a_2 z^2 + a_1 z + a_0$ with $a_0 \\in [-0.2, 0.5]$, $a_1 \\in [0.3, 0.5]$, $a_2 \\in [0.6, 1.3]$, $a_3 \\in [0.9, 1.2]$.";
        fontSize: 22;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a80";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e96" {
        x: 1032;
        y: 450;
        width: 736;
        height: 110;
        content: "• All four Kharitonov polynomials are stable (largest root moduli $0.83$, $0.79$, $0.98$, $0.82$ — all below $1$).";
        fontSize: 22;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a81";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e97" {
        x: 1032;
        y: 580;
        width: 736;
        height: 210;
        content: "• But the vertex member $p^{\\star}(z) = 0.9z^3 + 1.3z^2 + 0.3z + 0.5$ has a root of modulus $1.47 > 1$ — unstable. Four stable corners, yet the family is not stable.";
        fontSize: 22;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a82";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e98" {
        x: 120;
        y: 850;
        width: 1680;
        height: 110;
        fill: "#f2f6fa";
        radius: 8;
        animate {
            id: "a83";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e99" {
        x: 120;
        y: 850;
        width: 8;
        height: 110;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a84";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e100" {
        x: 160;
        y: 882;
        width: 1600;
        height: 46;
        content: "Discrete-time robustness needs polytopes, not intervals — and a theorem that works on any stability region.";
        fontSize: 26;
        fontWeight: 600;
        color: "#12233a";
        animate {
            id: "a85";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

