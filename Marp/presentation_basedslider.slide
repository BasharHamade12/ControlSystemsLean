slide "Formalizing the Edge Theorem for Robust Control Stability in Lean4" {
    id: "s1";
    background: "#ffffff";

    text "e1" {
        x: 160;
        y: 340;
        width: 1600;
        height: 290;
        content: "Formalizing the Edge Theorem\nfor Robust Control Stability in Lean4";
        fontSize: 76;
        fontWeight: 700;
        align: "center";
        lineHeight: 1.28;
        color: "#12233a";
    }

    text "e2" {
        x: 430;
        y: 690;
        width: 800;
        height: 200;
        content: "Bashar Youssef Hamade\nProf. Dr. Martina Maggio\nSaarland University";
        fontSize: 34;
        fontWeight: 500;
        lineHeight: 1.5;
        color: "#24313f";
        animate {
            id: "a1";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e3" {
        x: 430;
        y: 900;
        width: 900;
        height: 48;
        content: "Project: github.com/BasharHamade12/ControlSystemsLean";
        fontSize: 26;
        color: "#1f4e79";
        animate {
            id: "a2";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    image "e4" {
        x: 1310;
