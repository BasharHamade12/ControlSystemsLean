    text "e179" {
        x: 1042;
        y: 758;
        width: 726;
        height: 220;
        content: "Take $f(x,y) = -y$ and $c = 0$. Then $H = \\{(x,y) : y = 0\\}$ is the $x$-axis and $\\Omega$ lies above it, so $f \\le 0 = c$ on $\\Omega$ with $x_0 \\in \\Omega \\cap H$. Hence $H$ supports $\\Omega$, and the exposed set $\\Omega \\cap H$ is the bottom edge.";
        fontSize: 21;
        lineHeight: 1.5;
        color: "#24313f";
        math: true;
        animate {
            id: "a141";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

