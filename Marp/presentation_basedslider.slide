    text "e141" {
        x: 156;
        y: 664;
        width: 1120;
        height: 120;
        content: "Assumption. The Lean structure additionally requires a nonempty topological interior (interior_nonempty). Everything in this deck assumes it — the coefficient polytope has genuine dimension.";
        fontSize: 23;
        lineHeight: 1.45;
        color: "#24313f";
        animate {
            id: "a116";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
