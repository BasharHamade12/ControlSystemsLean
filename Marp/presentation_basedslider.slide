        y: 196;
        width: 8;
        height: 260;
        fill: "#1f4e79";
        radius: 4;
        animate {
            id: "a87";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e105" {
        x: 160;
        y: 222;
        width: 1600;
        height: 210;
        content: "Theorem (Edge Theorem; Bartlett–Hollot–Lin 1988). Let $\\Omega$ be a polytope of fixed-degree polynomials. Then $\\partial R(\\Omega) \\subseteq \\bigcup_{E} R(E)$ over the exposed edges $E$ of $\\Omega$. Hence the family is stable (Hurwitz, Schur, …) iff every exposed edge is — and each edge is a one-parameter family $a(\\lambda) = (1-\\lambda)a^{(1)} + \\lambda a^{(2)}$, $\\lambda \\in [0,1]$.";
        fontSize: 24;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a88";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e106" {
        x: 120;
        y: 496;
        width: 1680;
        height: 190;
        content: "Example (Ch. 6, Ex. 6.2). Family $\\delta(z;\\underline{\\delta}) = z^3 + \\delta_2 z^2 + \\delta_1 z + \\delta_0$ with $\\underline{\\delta} = (\\delta_3,\\delta_2,\\delta_1,\\delta_0) \\in \\Omega := \\{1\\} \\times [0.042,0.158] \\times [-0.058,0.058] \\times [-0.06,0.056] \\subset \\mathbb{R}^4$: a compact 3-dimensional box (8 vertices, 12 edges) with leading coefficient $\\equiv 1$.";
        fontSize: 24;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a89";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    image "e107" {
        x: 687;
        y: 706;
        width: 546;
        height: 270;
        src: "data:image/webp;base64,";
        animate {
            id: "a90";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e108" {
        x: 510;
        y: 986;
        width: 900;
        height: 30;
        content: "Ex. 6.2: the box (left) and its 12 edge root loci inside the unit disc (right)";
        fontSize: 19;
        align: "center";
        color: "#5a6673";
        animate {
            id: "a91";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }
}

slide "Section 1 · Preliminaries" {
