    text "e458" {
        x: 148;
        y: 192;
        width: 1640;
        height: 54;
        content: "Claim. Let $\\Omega \\subset \\mathbb{R}^{n+1}$ be a polytope with $n \\ge 1$, and let $F \\subseteq \\mathbb{R}^{n+1}$ be an exposed face of $\\Omega$ with $\\dim \\mathrm{aff}(F) \\ge 2$. If\n$r \\in \\mathbb{R}$ satisfies $(r:\\mathbb{C}) \\in R(F)$, then there exists an exposed edge $E$ of $\\Omega$ with $(r:\\mathbb{C}) \\in R(E)$.";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a351";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e459" {
        x: 120;
        y: 274;
        width: 880;
        height: 756;
        content: "lemma descend_to_exposed_edge {n : ℕ} (hn : n ≥ 1) (P : Polytope n) (r : ℝ)\n    (F : Set (CoeffVec n)) (hF_exp : IsExposedFace P F)\n    (hs_F : (r : ℂ) ∈ RootSpaceSet F)\n    (hF_dim_ge_2 : Module.finrank ℝ (affineSpan ℝ F).direction ≥ 2) :\n    ∃ E, IsExposedEdge P E ∧ (r : ℂ) ∈ RootSpaceSet E := by\n  let m_F := Module.finrank ℝ (affineSpan ℝ F).direction\n  by_cases hm_F_1 : m_F = 1\n  · refine ⟨F, isExposedEdge_of_dim_1 hF_exp hm_F_1, hs_F⟩\n  · have hm_F_ge_2 : m_F ≥ 2 := by omega\n\n-- Step 5.1\n    obtain ⟨δ_F, hδ_F_in_F, hδ_F_root⟩ :\n      ∃ δ ∈ F, ((polyOfVec δ).map (algebraMap ℝ ℂ)).IsRoot (r : ℂ) := hs_F\n    let affF := affineSpan ℝ F\n\n-- Step 5.1\n    have hδ_F_Psr : δ_F ∈ PsrSet n r := mem_P_sr_of_isRoot r δ_F hδ_F_root\n\n-- Step 5.2\n    have h_inter_dim : Module.finrank ℝ (meetDir n (P_sr n r) affF) ≥ 1 :=\n      intersection_affine_dim_ge_one (P_sr n r) affF δ_F hδ_F_Psr\n        (subset_affineSpan ℝ F hδ_F_in_F) (P_sr_dimension r) hm_F_ge_2\n\n-- Step 5.3\n    obtain ⟨δ_bound, hδ_bound_inter, hδ_bound_front, hδ_bound_not_relint⟩ :=\n      exists_boundary_point_in_face_rootspace P r δ_F F hF_exp hδ_F_in_F hδ_F_Psr h_inter_dim\n\n-- Step 5.5\n    have hδ_bound_in_F : δ_bound ∈ F := hδ_bound_inter.1\n    have hδ_bound_Psr : δ_bound ∈ (P_sr n r : Set (CoeffVec n)) := hδ_bound_inter.2\n\n-- Step 5.4\n    obtain ⟨G, hG_exp, hδ_bound_in_G, hG_dim_lt⟩ :=\n      exists_proper_subface_of_boundary_point P F hF_exp δ_bound\n        hδ_bound_in_F hδ_bound_front hδ_bound_not_relint hm_F_ge_2\n\n-- Step 5.6\n    have hs_G : (r : ℂ) ∈ RootSpaceSet G :=\n      rootspace_mem_of_eval_zero r δ_bound hδ_bound_Psr G hδ_bound_in_G";
        language: "lean";
        theme: "light";
        fontSize: 12;
        animate {
            id: "a352";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

