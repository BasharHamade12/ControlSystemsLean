        radius: 4;
        animate {
            id: "a242";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e322" {
        x: 148;
        y: 192;
        width: 1640;
        height: 78;
        content: "Claim. Let $U$ be linear with $\\dim U = n$, $\\mathrm{aff}\\Omega$ affine with $\\dim(\\mathrm{dir}(\\mathrm{aff}\\Omega)) \\ge 2$, and $\\delta \\in U \\cap \\mathrm{aff}\\Omega$. Then\n$\\dim(\\mathrm{meetDir}) \\ge 1$.\nProof. $\\mathrm{meetDir} = \\mathrm{dir}(\\mathrm{aff}(U \\cap \\mathrm{aff}\\Omega))$ by definition.";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a243";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e323" {
        x: 120;
        y: 298;
        width: 880;
        height: 579;
        content: "lemma intersection_affine_dim_ge_one {n : ℕ} (U : Submodule ℝ (CoeffVec n))\n    (affΩ : AffineSubspace ℝ (CoeffVec n))\n    (δ : CoeffVec n) (hδU : δ ∈ U) (hδΩ : δ ∈ affΩ)\n    (hU_dim : dim U = n) (haff_dim : dim affΩ.direction ≥ 2) :\n    dim (meetDir n U affΩ) ≥ 1 := by\n\n-- Step 2.1\n  unfold meetDir\n\n-- Step 2.2\n  let Aint : AffineSubspace ℝ (CoeffVec n) := U.toAffineSubspace ⊓ affΩ\n\n-- Step 2.3\n  have hA_dir : Aint.direction = U ⊓ affΩ.direction :=\n    intersection_direction_eq U affΩ δ hδU hδΩ\n\n-- Step 2.4\n  have hA_eq : affineSpan ℝ ((U : Set (CoeffVec n)) ∩ (affΩ : Set (CoeffVec n))) = Aint := by\n    rw [affineSpan_inter U affΩ]\n\n-- Step 2.5\n  rw [hA_eq, hA_dir]\n\n-- Step 2.6\n  exact finrank_inf_ge_one U affΩ.direction hU_dim haff_dim";
        language: "lean";
        theme: "light";
        fontSize: 14;
        animate {
            id: "a244";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e324" {
        x: 1036;
        y: 300;
        width: 764;
        height: 36;
        content: "Map";
        fontSize: 22;
        fontWeight: 700;
        color: "#12233a";
        animate {
            id: "a245";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e325" {
        x: 1036;
        y: 388;
        width: 38;
        height: 32;
        fill: "#1f4e79";
        radius: 6;
        text {
            content: "2.1";
            fontSize: 12;
            fontWeight: 700;
            align: "center";
            color: "#ffffff";
        }
        animate {
            id: "a246";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e326" {
        x: 1104;
        y: 404;
        width: 696;
        height: 49;
        content: "$\\mathrm{meetDir} = \\mathrm{dir}(\\mathrm{aff}(U \\cap \\mathrm{aff}\\Omega))$ by\ndefinition";
        fontSize: 16;
        lineHeight: 1.35;
        color: "#24313f";
        math: true;
        animate {
            id: "a247";
