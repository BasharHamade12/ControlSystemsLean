    }

    text "e622" {
        x: 120;
        y: 237;
        width: 820;
        height: 120;
        content: "Claim. Same goal for non-real $s^\\star$: a boundary root\nof $R(F)$ already lives on the relative boundary of $F$\n(complex slice $P_{s_c}$ in place of $P_{s_r}$).";
        fontSize: 23;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a481";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e623" {
        x: 120;
        y: 381;
        width: 820;
        height: 193;
        content: "New split. The slice $P_{s_c}(s^\\star)$ and the face\ndirections $\\mathrm{dir}\\,\\mathrm{aff}\\,F$ generically\nmeet only in $\\{0\\}$— no direction to walk. Case A shares\na nonzero direction $v$; Case B ($\\dim = 0$) is\ntransverse.";
        fontSize: 23;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a482";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e624" {
        x: 120;
        y: 599;
        width: 820;
        height: 83;
        content: "Case A ($\\dim \\ge 1$). Walk $v$ to the relative boundary\nand transfer the root— the real-case escape.";
        fontSize: 23;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a483";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e625" {
        x: 120;
        y: 707;
        width: 820;
        height: 156;
        content: "Case B ($\\dim = 0$). Non-roots $s_k \\to s^\\star$; Cramer\non $V_0, V_1$ ($\\det \\ne 0$) gives\n$\\delta_k \\to \\delta^\\star$ in $\\mathrm{aff}(F)$ carrying\n$s_k$.";
        fontSize: 23;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a484";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e626" {
        x: 120;
        y: 888;
        width: 820;
        height: 156;
        content: "Limit. $\\delta_k \\notin F$ yet\n$\\delta_k \\to \\delta^\\star$ rules out interior—\n$\\delta^\\star$ is on the relative boundary carrying\n$s^\\star$.";
