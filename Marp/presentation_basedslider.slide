    text "e437" {
        x: 148;
        y: 192;
        width: 1640;
        height: 101;
        content: "Claim. Let $\\delta_{\\mathrm{bound}} \\in \\mathrm{frontier}\\,P.\\Omega \\cap \\mathrm{PsrSet}\\,n\\,r = =\\; \\{\\,\\delta \\in \\mathbb{R}^{n+1} \\mid P_\\delta(r) = 0\\,\\} $ $\\;=\\;$\n$ \\{\\,\\delta \\mid \\delta_0 + \\delta_1 r + \\cdots + \\delta_n r^n = 0\\,\\}$\nwith $(\\mathrm{interior}\\,P.\\Omega).\\mathrm{Nonempty}$. Then there exists $F$ with\n$\\mathrm{IsExposedFace}\\,P\\,F \\land \\delta_{\\mathrm{bound}} \\in F \\land (r:\\mathbb{C}) \\in \\mathrm{RootSpaceSet}\\,F$.";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a336";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e438" {
        x: 120;
        y: 322;
        width: 880;
        height: 617;
        content: "-- Step 4.6\n  have hc_upper : ∀ x ∈ P.Ω, f_lin x ≤ c :=\n    supporting_hyperplane_upper_bound P f c hf_strict h_int_nonempty\n\n-- Step 4.7\n  let hp : SupportingHyperplane P := {\n    f           := f_lin\n    c           := c\n    nonzero     := hf_lin_ne\n    upper_bound := hc_upper\n    touches     := ⟨δ_bound, hδ_bound_in_Ω, rfl⟩\n  }\n\n-- Step 4.8\n  have hδ_in_face : δ_bound ∈ ExposedFace hp := by\n    unfold ExposedFace\n    simp only [Set.mem_setOf_eq]\n    exact ⟨hδ_bound_in_Ω, rfl⟩\n\n-- Step 4.9\n  have hr_in_rootspace : (r : ℂ) ∈ RootSpaceSet (ExposedFace hp) :=\n    rootspace_mem_of_eval_zero r δ_bound hδ_bound_Psr (ExposedFace hp) hδ_in_face\n\n-- Step 4.10\n  exact ⟨ExposedFace hp, ⟨hp, rfl⟩, hδ_in_face, hr_in_rootspace⟩";
        language: "lean";
        theme: "light";
        fontSize: 15;
        animate {
            id: "a337";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
