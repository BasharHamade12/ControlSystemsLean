    text "e291" {
        x: 156;
        y: 252;
        width: 930;
        height: 110;
        content: "Let $\\Omega \\subset \\mathbb{R}^{n+1}$ be a polytope satisfying Assumption 6.1.\nThen (1) a real root $s_r \\in R(\\Omega)$ lies in $R(E)$ for an exposed edge $E$;\n(2) a complex root $s_c \\in R(\\Omega)$ lies in $R(F)$ for an exposed face $F$.";
        fontSize: 18;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a220";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e292" {
        x: 130;
        y: 392;
        width: 990;
        height: 90;
        content: "1. Unpack. $s \\in R(\\Omega)$ with $\\mathrm{Im}(s) = 0$ gives\n$\\delta \\in \\Omega \\cap P_{s_r}(r)$ with $s = \\bar{r}$.";
        fontSize: 21;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a221";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 350;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e293" {
        x: 130;
        y: 492;
        width: 990;
        height: 90;
        content: "2. Count. $\\dim U = n$ and $\\dim \\mathrm{dir} \\ge 2$ give\n$\\dim(U \\cap \\mathrm{dir}) \\ge 1$.";
        fontSize: 21;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a222";
            effect: "fadeIn";
