        }
    }

    latex "e191" {
        x: 156;
        y: 460;
        width: 930;
        height: 100;
        content: "R(W) = \\{\\, s \\in \\mathbb{C} \\mid \\exists\\, \\delta \\in W,\\ \\delta(s) = 0 \\,\\}";
        fontSize: 30;
