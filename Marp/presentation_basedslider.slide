    code "e138" {
        x: 120;
        y: 248;
        width: 1180;
        height: 360;
        content: "/--\nA polytope Ω in coefficient space ℝ^{n+1}.\nIt is defined as the convex hull of a finite set of vertices V,\nand is assumed to have nonempty topological interior.\n-/\nstructure Polytope (n : ℕ) where\n  vertices : Finset (CoeffVec n)\n  nonempty  : vertices.Nonempty\n  interior_nonempty : (interior (convexHull ℝ (vertices : Set (CoeffVec n)))).Nonempty\n\n/-- The actual set Ω ⊆ ℝ^{n+1} as the convex hull of the vertices. -/\ndef Polytope.Ω (P : Polytope n) : Set (CoeffVec n) :=\n  convexHull ℝ (P.vertices : Set (CoeffVec n))";
        language: "lean";
        theme: "light";
        fontSize: 15;
        animate {
            id: "a113";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    rect "e139" {
