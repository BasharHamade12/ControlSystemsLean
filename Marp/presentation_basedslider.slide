slide "Step 5: Descend — Lean + map (2/2)" {
    id: "s44";
    background: "#ffffff";

    text "e473" {
        x: 120;
        y: 56;
        width: 1700;
        height: 76;
        content: "Step 5: Descend — Lean + map (2/2)";
        fontSize: 42;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e474" {
        x: 120;
        y: 148;
        width: 120;
        height: 6;
        fill: "#1f4e79";
        radius: 3;
    }

    code "e475" {
        x: 120;
        y: 192;
        width: 880;
        height: 579;
        content: "-- Step 5.8\n    by_cases hG_dim_ge_2 : Module.finrank ℝ (affineSpan ℝ G).direction ≥ 2\n    · exact descend_to_exposed_edge hn P r G hG_exp hs_G hG_dim_ge_2\n\n-- Step 5.9\n    · by_cases hG_dim_1 : Module.finrank ℝ (affineSpan ℝ G).direction = 1\n      · refine ⟨G, isExposedEdge_of_dim_1 hG_exp hG_dim_1, hs_G⟩\n\n-- Step 5.10\n      · -- dim(G) = 0: G is the singleton {δ_bound}; get an edge through it.\n        have hG_dim_0 : Module.finrank ℝ (affineSpan ℝ G).direction = 0 := by\n          have h_not_ge_2 : ¬ Module.finrank ℝ (affineSpan ℝ G).direction ≥ 2 := hG_dim_ge_2\n          have h_not_1 : ¬ Module.finrank ℝ (affineSpan ℝ G).direction = 1 := hG_dim_1\n          omega\n        have hG_single : G = {δ_bound} :=\n          exposed_face_dim_zero_singleton G hG_dim_0 δ_bound hδ_bound_in_G\n        obtain ⟨E, hE_edge, hδ_in_E⟩ :=\n          exists_exposed_edge_of_singleton hn P δ_bound G hG_exp hG_single\n        have h_root_E : (r : ℂ) ∈ RootSpaceSet E :=\n          rootspace_mem_of_eval_zero r δ_bound hδ_bound_Psr E hδ_in_E\n        exact ⟨E, hE_edge, h_root_E⟩\n\n-- Step 5.7\n  termination_by Module.finrank ℝ (affineSpan ℝ F).direction\n  decreasing_by exact hG_dim_lt";
        language: "lean";
        theme: "light";
        fontSize: 14;
        animate {
            id: "a366";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e476" {
        x: 1036;
        y: 194;
        width: 764;
        height: 36;
