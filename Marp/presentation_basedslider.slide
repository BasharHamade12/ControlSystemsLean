slide "Root space — definition" {
    id: "s18";
    background: "#ffffff";

    text "e182" {
        x: 120;
        y: 64;
        width: 1650;
        height: 90;
        content: "Root space — definition";
        fontSize: 54;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e183" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
