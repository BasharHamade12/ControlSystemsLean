    text "e522" {
        x: 120;
        y: 255;
        width: 820;
        height: 163;
        content: "Claim. If $s \\in R(\\Omega)$ with\n$\\mathrm{Im}(s) \\ne 0$, then $s \\in R(F)$ for an\nexposed face $F$ with $\\dim\\mathrm{aff}(F) \\le 2$— a\nface, not an edge.";
        fontSize: 24;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a399";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e523" {
        x: 120;
        y: 460;
        width: 820;
        height: 125;
        content: "Thinner slice. $U = \\{\\delta \\mid P_\\delta(s) = 0\\}$\nhas dimension $n - 1$: real and imaginary parts must\neach vanish— two equations cut twice.";
        fontSize: 24;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a400";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e524" {
        x: 120;
        y: 626;
        width: 820;
        height: 86;
        content: "Stronger count. Grassmann needs direction dimension\n$\\ge 3$ (and $n \\ge 2$).";
        fontSize: 24;
        lineHeight: 1.42;
        color: "#24313f";
        math: true;
        animate {
            id: "a401";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e525" {
        x: 120;
        y: 753;
        width: 820;
        height: 125;
        content: "Weaker target. One condition gives a line to walk to\nan edge; two give isolated points that cannot slide—\ndescent stops at dimension $2$.";
