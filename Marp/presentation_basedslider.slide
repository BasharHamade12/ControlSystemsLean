        }
    }

    code "e306" {
        x: 120;
        y: 522;
        width: 1040;
        height: 420;
        content: "theorem lemma61_real (hn : n ≥ 1) (P : Polytope n) (s : ℂ) (hs : s ∈ RootSpace P) :\n    s.im = 0 → ∃ E, IsExposedEdge P E ∧ s ∈ RootSpaceSet E := by\n  intro hreal\n  -- 1.1\n  unfold RootSpace RootSpaceSet at hs\n  obtain ⟨δ, hδ_in_Ω, hδ_root⟩ := hs\n  -- 1.2\n  have hs_real : s = ↑s.re := by\n    apply Complex.ext\n    · simp\n    · simp [hreal]\n  -- 1.3\n  have hδ_in_Psr : δ ∈ (P_sr n s.re : Set (CoeffVec n)) := by\n    rw [hs_real] at hδ_root\n    exact mem_P_sr_of_isRoot s.re δ hδ_root";
        language: "lean";
        theme: "light";
        fontSize: 15;
        animate {
            id: "a233";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
