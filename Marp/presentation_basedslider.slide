        radius: 4;
        animate {
            id: "a377";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e493" {
        x: 148;
        y: 192;
        width: 1640;
        height: 78;
        content: "Claim. Let $m := \\dim\\mathrm{aff}(\\Omega)$. Then $m = 0$ is impossible ($\\mathrm{int}\\,\\Omega \\neq \\emptyset$), and $m = 1$ makes $\\Omega$ itself the edge.\nProof. D.1 $m = 0$: polytope_direction_dim_pos gives $\\dim \\ge 1$, contradiction. D.2 $m = 1$: polytope_dim1_is_exposed_edge makes $\\Omega$ itself the edge; $s = \\bar{r}$ moves the\nroot witness to $E$.";
        fontSize: 16;
        lineHeight: 1.45;
        color: "#24313f";
        math: true;
        animate {
            id: "a378";
            effect: "fadeIn";
            trigger: "afterPrevious";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    code "e494" {
        x: 120;
        y: 298;
        width: 880;
        height: 414;
        content: "-- Step ①\n  · by_cases hm0 : m = 0\n    · have h_pos : Module.finrank ℝ (affineSpan ℝ P.Ω).direction ≥ 1 :=\n        polytope_direction_dim_pos P\n      omega\n\n-- Step ②\n    · have hm1 : m = 1 := by omega\n      have h_Ω_is_edge : IsExposedEdge P P.Ω :=\n        polytope_dim1_is_exposed_edge hn P hm1\n      refine ⟨P.Ω, h_Ω_is_edge, ?_⟩\n      rw [hs_real]\n      exact rootspace_mem_of_eval_zero s.re δ\n        (mem_P_sr_of_isRoot s.re δ (by\n          rw [← hs_real]\n          exact hδ_root)) P.Ω hδ_in_Ω";
        language: "lean";
        theme: "light";
        fontSize: 15;
        animate {
            id: "a379";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 400;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e495" {
        x: 1036;
