slide "Assumption 6.1 & Lemmas 6.1–6.2" {
    id: "s24";
    background: "#ffffff";

    text "e232" {
        x: 120;
        y: 64;
        width: 1700;
        height: 90;
        content: "Assumption 6.1 & Lemmas 6.1–6.2";
        fontSize: 50;
        fontWeight: 700;
        color: "#12233a";
    }

    rect "e233" {
        x: 120;
        y: 170;
        width: 120;
        height: 6;
        fill: "#1f4e79";
