    code "e682" {
        x: 120;
        y: 196;
        width: 1680;
        height: 114;
        content: "theorem edge_theorem {n : ℕ} (hn : n ≥ 1) (P : Polytope n) (s : ℂ)\n    (hleading : ∀ v ∈ P.vertices, 0 < v (Fin.last n))\n    (hs : s ∈ frontier (RootSpace P)) :\n    ∃ E, IsExposedEdge P E ∧ s ∈ RootSpaceSet E := by";
        language: "lean";
        theme: "light";
        fontSize: 16;
        animate {
            id: "a529";
            effect: "fadeIn";
            trigger: "onClick";
            duration: 320;
            delay: 0;
            easing: "easeOut";
            direction: "up";
            repeat: 1;
        }
    }

    text "e683" {
        x: 120;
        y: 334;
        width: 820;
        height: 18;
        content: "EdgeTheorem.lean:90-121 — proof (1/2)";
